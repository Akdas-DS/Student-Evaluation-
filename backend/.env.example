# Security Keys
SECRET_KEY=generate_a_secure_random_string_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local development: sqlite:///./kt_risk.db
# For production (Vercel/Render): PostgreSQL database URL (e.g., from Neon, Supabase, or Render)
DATABASE_URL=postgresql://user:password@host:port/database

# CORS Configuration
# Comma-separated list of allowed origins. In production, add your Vercel URL here.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-vercel-frontend-url.vercel.app
